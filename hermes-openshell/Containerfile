# Hermes Agent for OpenShell sandbox
#
# NOTE: this repo does not build this image. It is kept here for provenance
# and reproducibility — see hermes-openshell/README.md for why, and how to rebuild it
# if the pinned tag ever needs bumping. The tag actually deployed is set in
# the workshop repo's tenant-platform chart (agent.hermes.image.*) — update
# it there after each rebuild.
#
# Adapts the cai-krew Hermes container for OpenShell sandbox use.
# Includes the RHRolun fork with the Slack extra installed (unused by this
# deployment's own gateway invocation — see README) plus otel/MLflow tracing deps.
#
# Hermes is installed system-wide (no venv) so the binary lands at
# /usr/local/bin/hermes, which is under /usr - always readable and
# executable in the default OpenShell Landlock policy.
#
# Build:
#   podman build --platform linux/amd64 -t hermes-openshell:latest -f hermes-openshell/Containerfile hermes-openshell/
#
# Use in OpenShell (see the workshop's tenant-openshell bridge for the full flow):
#   openshell sandbox create --name hermie --from <this image> --no-tty -- true
#   openshell sandbox upload hermie /hermes /sandbox
#   openshell sandbox exec --name hermie -- start-hermes

FROM quay.io/hmoghani/openshell-base:latest

LABEL name="hermes" \
      summary="Hermes agent (RHRolun fork) for OpenShell sandbox"

USER 0

# Python 3.12 + build deps (gcc for native extensions like faster-whisper)
RUN microdnf install -y --nodocs python3.12 python3.12-pip git gcc && \
    ln -sf /usr/bin/python3.12 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.12 /usr/bin/python && \
    microdnf clean all && \
    rm -rf /var/cache/yum

# Clone RHRolun fork and install with the Slack extra (system-wide, no venv).
RUN git clone --depth 1 https://github.com/RHRolun/hermes-agent.git /tmp/hermes-agent && \
    pip3.12 install --no-cache-dir "/tmp/hermes-agent[slack]" && \
    rm -rf /tmp/hermes-agent

# mcp.client.streamable_http — without it, MCP servers configured with
# streamable-http transport fail with "requires HTTP transport but
# mcp.client.streamable_http is not available" (confirmed live against a real
# deployment). Pinned to exactly the versions hermes-agent 0.17.0 declares for
# its own [mcp] extra (`mcp==1.26.0; extra == "mcp"`,
# `starlette==1.0.1; extra == "mcp"`) rather than resolved through the extra
# itself, matching the fix already validated in the sibling
# quay.io/ckavili/hermes-mem0 image build.
RUN pip3.12 install --no-cache-dir "mcp==1.26.0" "starlette==1.0.1" && \
    python3.12 -c "import mcp.client.streamable_http"

# Extra deps from cai-krew build (otel, whisper, yaml)
# Pre-install elevenlabs so hermes doesn't attempt a runtime pip install (blocked by network policy)
RUN pip3.12 install --no-cache-dir \
    pyyaml \
    faster-whisper \
    elevenlabs \
    ddgs \
    opentelemetry-api \
    opentelemetry-sdk \
    opentelemetry-exporter-otlp-proto-http

# MLflow tracing (Python SDK + kubernetes-namespaced auth for RHOAI)
RUN pip3.12 install --no-cache-dir 'mlflow[kubernetes]>=3.12'

# Lab helpers, shared by every participant. Under /usr/local because OpenShell's
# default filesystem policy lets the sandbox read /usr but not /opt.
#
#   start-hermes            (re)starts Hermes and its token refresher from the
#                           participant's uploaded settings in /sandbox/hermes;
#                           run by the participant, and by the workshop's
#                           bridge when the operator's Keycloak roles change
#   mcp-token-refresh.py    fetches and refreshes Hermes' MCP Gateway token
#   plugins/hermes_otel     MLflow tracing plugin; start-hermes copies it into
#                           $HERMES_HOME/plugins with the participant's config
#
# Only per-participant settings — keys, tokens, URLs — are uploaded at runtime.
COPY start-hermes.sh /usr/local/bin/start-hermes
COPY mcp-token-refresh.py /usr/local/share/hermes-lab/mcp-token-refresh.py
RUN chmod 0755 /usr/local/bin/start-hermes && \
    chmod 0644 /usr/local/share/hermes-lab/mcp-token-refresh.py

# hermes_otel, pinned to a commit and checked against its digest, like every
# other version in this lab. Release hermes-otel 1.13.0, 2026-09-22.
ARG HERMES_OTEL_REPO=briancaffey/hermes-otel
ARG HERMES_OTEL_COMMIT=a2afa2203e55f3bc261003f4f86fa01b62be32db
ARG HERMES_OTEL_SHA256=b0b1c82011d0dbcbfeaa370cb9e74ffb7370c0fb42742f19824a37394e54c077
RUN mkdir -p /usr/local/share/hermes-lab/plugins/hermes_otel && \
    curl -fsSL -o /tmp/hermes-otel.tar.gz \
      "https://github.com/${HERMES_OTEL_REPO}/archive/${HERMES_OTEL_COMMIT}.tar.gz" && \
    echo "${HERMES_OTEL_SHA256}  /tmp/hermes-otel.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/hermes-otel.tar.gz --strip-components=2 \
      -C /usr/local/share/hermes-lab/plugins/hermes_otel \
      "${HERMES_OTEL_REPO##*/}-${HERMES_OTEL_COMMIT}/hermes_otel" && \
    rm -f /tmp/hermes-otel.tar.gz && \
    chmod -R a+rX /usr/local/share/hermes-lab && \
    test -f /usr/local/share/hermes-lab/plugins/hermes_otel/__init__.py

# Verify install
RUN hermes --version

# Sandbox runs as root with HOME=/root; /sandbox/ is a PVC mount (wiped at start)
# HERMES_HOME points to the PVC so config survives agent restarts
USER 0
WORKDIR /workspace

ENV AGENT_NAME=hermes \
    HERMES_HOME=/sandbox/.hermes \
    PATH="/usr/local/bin:/sandbox/.local/bin:${PATH}"
